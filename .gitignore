# ================================
# Forever Full-Stack .gitignore
# ================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables / secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Build output
dist/
build/
.next/
out/
.vercel/

# Vite
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage / test output
coverage/
.nyc_output/

# Cache / temporary files
.cache/
.parcel-cache/
.tmp/
tmp/
temp/

# Uploaded/generated local files
uploads/

# Operating system files
.DS_Store
.DS_Store?
Thumbs.db
Thumbs.db
desktop.ini

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# Local databases
*.db
*.sqlite
*.sqlite3

# Certificates / private keys
*.pem
*.key
*.crt
*.p12

# Debug files
*.seed
*.pid
*.pid.lock

# Optional local configuration
*.local

# Package manager debug files
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# OS / editor backup files
*~
*.bak
*.backup
